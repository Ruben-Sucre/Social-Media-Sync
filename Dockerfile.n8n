# Dockerfile personalizado para n8n con Python y dependencias del proyecto
# Usamos una imagen base con Python y luego instalamos n8n
FROM python:3.12-slim

USER root

# Instalar Node.js y dependencias del sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    build-essential \
    ffmpeg \
    chromium \
    chromium-driver \
    fonts-liberation \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Instalar Node.js (requerido para n8n)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Instalar n8n globalmente
RUN npm install -g n8n

# Crear usuario node
RUN useradd -m -u 1000 -s /bin/bash node

# Crear directorio de trabajo
WORKDIR /workspace/social-media-sync

# Copiar requirements.txt
COPY requirements.txt .

# Instalar dependencias de Python
RUN pip3 install --no-cache-dir -r requirements.txt

# Instalar Playwright y navegadores
# Cambiar a usuario node primero para que los navegadores se instalen en su home
RUN pip3 install playwright==1.49.1

# Instalar navegadores como usuario node
RUN mkdir -p /home/node/.cache && \
    chown -R node:node /home/node/.cache

USER node
RUN playwright install chromium

USER root
RUN playwright install-deps chromium || true

# Variables de entorno para Python y n8n
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/social-media-sync \
    PATH="/workspace/social-media-sync:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    N8N_USER_FOLDER=/home/node/.n8n

# Cambiar ownership
RUN chown -R node:node /workspace/social-media-sync && \
    chown -R node:node /home/node

# Volver al usuario node
USER node

WORKDIR /home/node

EXPOSE 5678

CMD ["n8n"]
